{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem"
      }
    },
    "schemas": {
      "FieldError": {
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          },
          "uptime_s": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "uptime_s"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem.",
        "properties": {
          "detail": {
            "description": "Present on 4xx only.",
            "type": "string"
          },
          "errors": {
            "description": "Present on validation problems only.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "The request id.",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "`https://triage.studio/problems/<slug>`",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Triage",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "The version and uptime of the running daemon; `triage status` reads it.",
        "operationId": "health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon is up"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Daemon health"
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7311"
    }
  ]
}
