{
  "components": {
    "responses": {
      "Problem": {
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        },
        "description": "An RFC 9457 problem"
      }
    },
    "schemas": {
      "CreateHello": {
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "type": "object"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ],
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string"
          },
          "uptime_s": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "uptime_s"
        ],
        "type": "object"
      },
      "Hello": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "A ULID.",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "An RFC 9457 problem.",
        "properties": {
          "detail": {
            "description": "Present on 4xx only.",
            "type": "string"
          },
          "errors": {
            "description": "Present on validation problems only.",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array"
          },
          "instance": {
            "description": "The request id.",
            "format": "uri-reference",
            "type": "string"
          },
          "status": {
            "format": "int32",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "`https://triage.studio/problems/<slug>`",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Triage",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/hello": {
      "get": {
        "description": "The 20 newest, newest first.",
        "operationId": "hello_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Hello"
                  },
                  "type": "array"
                }
              }
            },
            "description": "The newest hellos"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "List hellos",
        "tags": [
          "hello"
        ]
      },
      "post": {
        "description": "Trims the name, which must then be 1 to 80 characters.",
        "operationId": "hello_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateHello"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hello"
                }
              }
            },
            "description": "The new hello"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Create a hello",
        "tags": [
          "hello"
        ]
      }
    },
    "/api/hello/{id}": {
      "get": {
        "operationId": "hello_get",
        "parameters": [
          {
            "description": "The hello's ULID",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hello"
                }
              }
            },
            "description": "The hello"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Get a hello",
        "tags": [
          "hello"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "The version and uptime of the running daemon; `triage status` reads it.",
        "operationId": "health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The daemon is up"
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "summary": "Daemon health"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
